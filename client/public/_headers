/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https:
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# No Cache-Control on this block on purpose. Cloudflare appends matching rules
# instead of letting the more specific one win, so a value here produced
# "max-age=3600, must-revalidate, max-age=31536000, immutable" on /assets/* and
# the browser honoured the shortest TTL. HTML keeps Cloudflare's default, which
# already revalidates on every request.

# Vite fingerprints these filenames, so they can never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not fingerprinted, so this directory follows a strict rule: replacing an image
# means giving it a NEW filename (power-station-v2.jpg) and re-running the build,
# never overwriting the bytes behind an existing name — otherwise the one-year
# immutable header keeps serving the old picture. Icons live outside /images and
# revalidate on every request.
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Filenames are stable; binaries only change when the weight list changes.
/fonts/*
  Cache-Control: public, max-age=2592000

# Browsers keep favicons far longer than the HTTP cache says, and they live at
# fixed paths, so a rebrand otherwise shows up days later (or never). Revalidate
# every time: the payload is a few KB and the ETag makes it a 304.
#
# Wildcards, not exact paths: Pages matches these patterns against the request
# including its query string, so "/favicon.svg" alone would miss "/favicon.svg?v=2".
/favicon.*
  Cache-Control: public, max-age=0, must-revalidate

/apple-touch-icon.png*
  Cache-Control: public, max-age=0, must-revalidate
