/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https:
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# No Cache-Control on this block on purpose. Cloudflare appends matching rules
# instead of letting the more specific one win, so a value here produced
# "max-age=3600, must-revalidate, max-age=31536000, immutable" on /assets/* and
# the browser honoured the shortest TTL. HTML keeps Cloudflare's default, which
# already revalidates on every request.

# Vite fingerprints these filenames, so they can never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not fingerprinted: these were re-encoded in this very release, so a one-year
# immutable header would have pinned the old files.
/images/*
  Cache-Control: public, max-age=604800

# Filenames are stable; binaries only change when the weight list changes.
/fonts/*
  Cache-Control: public, max-age=2592000
