# npm's strict peer resolution rejects this tree: @builder.io/vite-plugin-jsx-loc
# declares vite ^4 || ^5 while the project is on vite 7. The plugin is only used
# by the dev-time JSX source locator, so the looser resolution is fine.
#
# Without this, `npm ci` fails on the Cloudflare Pages build machine before it
# ever reaches the build command.
legacy-peer-deps=true
